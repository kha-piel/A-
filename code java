import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.Collections;

public class PathfindingApp extends JFrame {

    public PathfindingApp() {
        this.setTitle("Đồ Án Tìm Đường - A* Visualization");
        this.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        this.setResizable(false);

        // Thêm Panel chính
        GamePanel gamePanel = new GamePanel();
        this.add(gamePanel);
        
        this.pack();
        this.setLocationRelativeTo(null);
        this.setVisible(true);
    }

    public static void main(String[] args) {
        // Chạy trên luồng giao diện để đảm bảo mượt mà
        SwingUtilities.invokeLater(() -> new PathfindingApp());
    }
}

// --- LỚP CHÍNH XỬ LÝ LOGIC VÀ ĐỒ HỌA ---
class GamePanel extends JPanel implements ActionListener {

    // Cấu hình màn hình
    final int maxCol = 25;
    final int maxRow = 18;
    final int nodeSize = 35; // Kích thước ô
    final int screenWidth = nodeSize * maxCol;
    final int screenHeight = nodeSize * maxRow;

    // Node và Lưới
    Node[][] node = new Node[maxCol][maxRow];
    Node startNode, goalNode, currentNode;
    ArrayList<Node> openList = new ArrayList<>();
    ArrayList<Node> checkedList = new ArrayList<>();
    ArrayList<Node> pathList = new ArrayList<>();

    // Trạng thái
    boolean goalReached = false;
    boolean isRunning = false;
    Timer timer; // Dùng Timer để tạo animation mượt

    // Nút bấm điều khiển
    JButton btnStart, btnReset, btnRandomMap;

    public GamePanel() {
        this.setPreferredSize(new Dimension(screenWidth, screenHeight + 60)); // +60 cho thanh điều khiển
        this.setBackground(new Color(236, 240, 241));
        this.setLayout(null); // Layout tự do để đặt nút
        
        // Khởi tạo xử lý chuột
        MouseHandler mouseHandler = new MouseHandler();
        this.addMouseListener(mouseHandler);
        this.addMouseMotionListener(mouseHandler);

        // Khởi tạo nút bấm
        initControls();

        // Khởi tạo lưới
        initGrid();
        
        // Timer cho animation (tốc độ 15ms/khung hình)
        timer = new Timer(1, this); 
    }

    private void initControls() {
        Font btnFont = new Font("Segoe UI", Font.BOLD, 14);

        btnStart = createButton("Bắt đầu (A*)", 20, screenHeight + 10, new Color(46, 204, 113));
        btnStart.addActionListener(e -> startSearch());

        btnReset = createButton("Làm mới", 180, screenHeight + 10, new Color(231, 76, 60));
        btnReset.addActionListener(e -> resetGrid());

        btnRandomMap = createButton("Tạo tường ngẫu nhiên", 320, screenHeight + 10, new Color(52, 152, 219));
        btnRandomMap.addActionListener(e -> generateRandomWalls());

        this.add(btnStart);
        this.add(btnReset);
        this.add(btnRandomMap);
    }

    private JButton createButton(String text, int x, int y, Color bg) {
        JButton btn = new JButton(text);
        btn.setBounds(x, y, 150, 40);
        btn.setBackground(bg);
        btn.setForeground(Color.WHITE);
        btn.setFont(new Font("Segoe UI", Font.BOLD, 12));
        btn.setFocusPainted(false);
        btn.setBorderPainted(false);
        return btn;
    }

    private void initGrid() {
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                node[col][row] = new Node(col, row);
            }
        }
        // Đặt vị trí mặc định
        setStartNode(4, 8);
        setGoalNode(20, 8);
    }

    private void setStartNode(int col, int row) {
        node[col][row].setAsStart();
        startNode = node[col][row];
        currentNode = startNode;
    }

    private void setGoalNode(int col, int row) {
        node[col][row].setAsGoal();
        goalNode = node[col][row];
    }

    private void resetGrid() {
        goalReached = false;
        isRunning = false;
        timer.stop();
        openList.clear();
        checkedList.clear();
        pathList.clear();
        btnStart.setEnabled(true);

        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                node[col][row].reset(); // Reset trạng thái nhưng giữ lại tường
            }
        }
        // Đặt lại start/goal
        setStartNode(startNode.col, startNode.row);
        setGoalNode(goalNode.col, goalNode.row);
        repaint();
    }

    private void startSearch() {
        if (isRunning) return;
        resetGrid(); // Reset đường cũ(nếu có)
        
        isRunning = true;
        btnStart.setEnabled(false); // Khóa nút start
        
        // Tính toán chi phí ban đầu cho A*
        initAStar();
        
        timer.start(); // Bắt đầu chạy animation
    }

    private void generateRandomWalls() {
        resetGrid();
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                // Giữ lại Start và Goal
                if (node[col][row] == startNode || node[col][row] == goalNode) continue;
                
                node[col][row].setAsOpen(); // Xóa tường cũ
                // 30% cơ hội tạo tường
                if (Math.random() < 0.3) {
                    node[col][row].setAsSolid();
                }
            }
        }
        repaint();
    }

    // --- LOGIC A* (A-STAR) ---
    private void initAStar() {
        startNode.gCost = 0;
        startNode.hCost = getDistance(startNode, goalNode);
        startNode.calculateFCost();
        openList.add(startNode);
    }

    private void autoSearch() {
        if (openList.isEmpty()) {
            timer.stop();
            System.out.println("Không tìm thấy đường đi!");
            return;
        }

        //  Tìm node có F Cost thấp nhất trong OpenList
        Node bestNode = openList.get(0);
        for (int i = 1; i < openList.size(); i++) {
            if (openList.get(i).fCost < bestNode.fCost) {
                bestNode = openList.get(i);
            } else if (openList.get(i).fCost == bestNode.fCost) {
                if (openList.get(i).gCost > bestNode.gCost) {
                    bestNode = openList.get(i);
                }
            }
        }
        currentNode = bestNode;

        // 2. Nếu đến đích
        if (currentNode == goalNode) {
            goalReached = true;
            trackThePath();
            timer.stop();
            return;
        }

        // 3. Chuyển từ Open sang Checked (Closed)
        openList.remove(currentNode);
        checkedList.add(currentNode);
        currentNode.checked = true; // Để vẽ màu

        // 4. Mở các ô hàng xóm
        openNode(currentNode.col, currentNode.row - 1); // Lên
        openNode(currentNode.col, currentNode.row + 1); // Xuống
        openNode(currentNode.col - 1, currentNode.row); // Trái
        openNode(currentNode.col + 1, currentNode.row); // Phải
    }

    private void openNode(int col, int row) {
        if (col < 0 || col >= maxCol || row < 0 || row >= maxRow) return;
        
        Node neighbor = node[col][row];

        if (!neighbor.solid && !checkedList.contains(neighbor)) {
            int newGCost = currentNode.gCost + 1; // Khoảng cách node kề nhau là 1

            if (newGCost < neighbor.gCost || !openList.contains(neighbor)) {
                neighbor.gCost = newGCost;
                neighbor.hCost = getDistance(neighbor, goalNode);
                neighbor.calculateFCost();
                neighbor.parent = currentNode;

                if (!openList.contains(neighbor)) {
                    openList.add(neighbor);
                    neighbor.open = true; // Để vẽ màu đang xét
                }
            }
        }
    }

    private void trackThePath() {
        Node current = goalNode;
        while (current != startNode) {
            current = current.parent;
            if (current != startNode) {
                pathList.add(current);
                current.setAsPath();
            }
        }
    }
    
    // Hàm Heuristic (Khoảng cách Manhattan)
    private int getDistance(Node nodeA, Node nodeB) {
        int xDist = Math.abs(nodeA.col - nodeB.col);
        int yDist = Math.abs(nodeA.row - nodeB.row);
        return xDist + yDist;
    }

    // --- VÒNG LẶP GAME (GAME LOOP) ---
    @Override
    public void actionPerformed(ActionEvent e) {
        if (isRunning && !goalReached) {
            autoSearch(); // Chạy 1 bước thuật toán
            repaint();    // Vẽ lại màn hình
        }
    }

    // --- VẼ ĐỒ HỌA ---
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        
        // Khử răng cưa cho đẹp
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Vẽ lưới
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                node[col][row].draw(g2d, nodeSize);
            }
        }
    }

    // --- XỬ LÝ CHUỘT (Vẽ tường) ---
    class MouseHandler extends MouseAdapter {
        @Override
        public void mouseDragged(MouseEvent e) {
            drawWall(e);
        }
        @Override
        public void mousePressed(MouseEvent e) {
            drawWall(e);
        }
        
        private void drawWall(MouseEvent e) {
            if (isRunning) return; // Đang chạy thì không vẽ
            
            int col = e.getX() / nodeSize;
            int row = e.getY() / nodeSize;

            if (col >= 0 && col < maxCol && row >= 0 && row < maxRow) {
                Node n = node[col][row];
                // Không vẽ đè lên Start/Goal
                if (n != startNode && n != goalNode) {
                    if (SwingUtilities.isLeftMouseButton(e)) {
                        n.setAsSolid(); // Chuột trái vẽ tường
                    } else if (SwingUtilities.isRightMouseButton(e)) {
                        n.setAsOpen(); // Chuột phải xóa tường
                    }
                    repaint();
                }
            }
        }
    }
}

// --- CLASS NODE (DỮ LIỆU Ô) ---
class Node {
    int col, row;
    int gCost, hCost, fCost;
    Node parent;
    boolean start, goal, solid, open, checked, path;
    
    public Node(int col, int row) {
        this.col = col;
        this.row = row;
    }
    
    public void setAsStart() { start = true; goal = false; solid = false; }
    public void setAsGoal() { goal = true; start = false; solid = false; }
    public void setAsSolid() { solid = true; }
    public void setAsOpen() { open = false; checked = false; solid = false; path = false; }
    public void setAsPath() { path = true; }

    public void calculateFCost() {
        fCost = gCost + hCost;
    }
    
    public void reset() {
        open = false; checked = false; path = false;
        gCost = 0; hCost = 0; fCost = 0;
        parent = null;
        // Giữ lại start, goal, solid
    }

    public void draw(Graphics2D g2, int size) {
        int x = col * size;
        int y = row * size;
        int gap = 1; // Khoảng hở giữa các ô

        // Chọn màu
        if (start) g2.setColor(new Color(46, 204, 113));       // Xanh lá (Start)
        else if (goal) g2.setColor(new Color(231, 76, 60));    // Đỏ (Đích)
        else if (solid) g2.setColor(new Color(44, 62, 80));    // Đen xám (Tường)
        else if (path) g2.setColor(new Color(241, 196, 15));   // Vàng (Đường đi)
        else if (checked) g2.setColor(new Color(52, 152, 219)); // Xanh dương (Đã duyệt)
        else if (open) g2.setColor(new Color(120, 224, 143));   // Xanh nhạt (Đang chờ duyệt)
        else g2.setColor(Color.WHITE);                          // Trắng (Trống)

        // Vẽ ô bo tròn
        g2.fillRoundRect(x + gap, y + gap, size - gap*2, size - gap*2, 10, 10);
        
        // Vẽ viền mờ
        if (!solid && !start && !goal && !path && !checked) {
             g2.setColor(new Color(220, 220, 220));
             g2.drawRoundRect(x + gap, y + gap, size - gap*2, size - gap*2, 10, 10);
        }
    }
}
